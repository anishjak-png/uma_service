# Supabase (PostgreSQL) — required for all environments
# Create a project at https://supabase.com → Settings → Database → Connection string
#
# Pooler URL (port 6543) — used by the app at runtime (Vercel, local dev)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Direct URL (port 5432) — used by Prisma for db push / migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

SESSION_SECRET="change-this-to-a-long-random-string-min-32-chars"
RECEPTION_PIN="1234"
TECHNICIAN_PIN="5678"
ADMIN_PIN="9999"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHOP_NAME="Uma Traders"
NEXT_PUBLIC_SHOP_PHONE="9876543210"

# Supabase Storage — product photo uploads (optional)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="product-photos"

# LAN thermal printing (print agent on shop PC — optional, not the database)
PRINT_AGENT_API_KEY="change-this-print-agent-secret-key"
# PRINT_AGENT_APP_URL="https://your-app.vercel.app"
# THERMAL_PRINTER_HOST="192.168.1.100"
# THERMAL_PRINTER_PORT="9100"
# PRINT_AGENT_POLL_MS="2000"
