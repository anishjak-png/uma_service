generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  id        String    @id @default(cuid())
  name      String?
  mobile    String    @unique
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  jobCards  JobCard[]
}

enum JobStatus {
  Pending
  WaitingForCustomerApproval
  Ready
  Return
  Delivered
}

model LookupOption {
  id       String @id @default(cuid())
  category String
  value    String

  @@unique([category, value])
  @@index([category])
}

model Technician {
  id                String                @id @default(cuid())
  name              String                @unique
  active            Boolean               @default(true)
  assignedJobs      JobCard[]             @relation("AssignedTechnician")
  completedJobs     JobCard[]             @relation("CompletedByTechnician")
  applianceMappings ApplianceTechnician[]
  createdAt         DateTime              @default(now())
}

model ApplianceTechnician {
  id            String     @id @default(cuid())
  applianceType String     @unique
  technicianId  String
  technician    Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)
}

model JobCard {
  id                   String          @id @default(cuid())
  jobNumber            String          @unique
  customerId           String
  customer             Customer        @relation(fields: [customerId], references: [id])
  applianceType        String
  brand                String
  model                String?
  complaint            String
  physicalCondition    String?
  productPhotos        String?
  serviceAmount        Float?
  status               JobStatus       @default(Pending)
  remarks              String?
  receivedAt           DateTime        @default(now())
  readyAt              DateTime?
  deliveredAt          DateTime?
  createdBy            String?
  assignedTechnicianId     String?
  assignedTechnician       Technician?     @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])
  completedByTechnicianId  String?
  completedByTechnician    Technician?     @relation("CompletedByTechnician", fields: [completedByTechnicianId], references: [id])
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  statusHistory            StatusHistory[]
  printJobs                PrintJob[]

  @@index([customerId])
  @@index([status])
  @@index([assignedTechnicianId])
  @@index([completedByTechnicianId])
  @@index([receivedAt])
}

model StatusHistory {
  id        String    @id @default(cuid())
  jobCardId String
  jobCard   JobCard   @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  status    JobStatus
  note      String?
  changedBy String?
  changedAt DateTime  @default(now())

  @@index([jobCardId])
}

model JobSequence {
  id      Int @id @default(1)
  lastNum Int @default(0)
}

enum PrintJobStatus {
  Pending
  Printing
  Done
  Failed
}

model PrintJob {
  id        String         @id @default(cuid())
  jobCardId String
  jobCard   JobCard        @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  type      String         @default("receipt")
  status    PrintJobStatus @default(Pending)
  attempts  Int            @default(0)
  lastError String?
  createdAt DateTime       @default(now())
  printedAt DateTime?

  @@index([status, createdAt])
}
